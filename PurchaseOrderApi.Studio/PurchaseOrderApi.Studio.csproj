<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PurchaseOrderApi.Studio</RootNamespace>
    <!-- Allow preview packages -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Elsa Studio shell + modules -->
	  <PackageReference Include="Elsa.Api.Client" Version="3.6.1" />
	  <PackageReference Include="Elsa.Studio" Version="3.6.1" />
	  <PackageReference Include="Elsa.Studio.Labels" Version="3.6.1" />
	  <PackageReference Include="Elsa.Studio.Login.BlazorWasm" Version="3.6.1" />
	  <PackageReference Include="Elsa.Studio.WorkflowContexts" Version="3.6.1" />
	  <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.2" />
	  <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.2" PrivateAssets="all" />

	  <PackageReference Include="Elsa.Studio.Shell" Version="3.6.1" />
    <PackageReference Include="Elsa.Studio.Dashboard" Version="3.6.1" />
    <PackageReference Include="Elsa.Studio.Workflows" Version="3.6.1" />
    <PackageReference Include="Elsa.Studio.Workflows.Designer" Version="3.6.1" />
    <PackageReference Include="Elsa.Studio.Core.BlazorWasm" Version="3.6.1" />
  </ItemGroup>
</Project>
