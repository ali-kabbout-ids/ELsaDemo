<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PurchaseOrderApi</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core Elsa runtime -->
    <PackageReference Include="Elsa" Version="3.6.1" />
    <PackageReference Include="Elsa.EntityFrameworkCore.SqlServer" Version="3.5.3" />
    <PackageReference Include="Elsa.Http" Version="3.6.1" />
    <PackageReference Include="Elsa.Labels" Version="3.6.1" />
    <PackageReference Include="Elsa.Persistence.EFCore.SqlServer" Version="3.6.1" />
    <PackageReference Include="Elsa.Resilience" Version="3.6.1" />
    <!-- REST API endpoints — required for Elsa Studio to connect -->
    <PackageReference Include="Elsa.Workflows.Api" Version="3.6.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.13" />
    <!-- Swagger UI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.*" />
  </ItemGroup>
</Project>
